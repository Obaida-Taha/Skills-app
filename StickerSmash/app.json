{
  "expo": {
    "name": "Skill+",
    "slug": "skillplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skillplus",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.obaidataha.skillplus"
    },
    "android": {
      "package": "com.obaidataha.skillplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7357FF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#7357FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}