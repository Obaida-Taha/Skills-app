{
  "expo": {
    "name": "Skill+",
    "slug": "skillplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skillplus",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.obaidataha.skillplus",
      "appleTeamId": "TQ8K5RDT5N"
    },
    "android": {
      "package": "com.obaidataha.skillplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7357FF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#121212",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "527e9d93-de86-4b46-b523-9d3421f5bb08"
      }
    }
  }
}
