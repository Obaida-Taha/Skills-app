# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat
# This dedicated test ZIP already contains the supplied Test Store public key
# as a DEVELOPMENT-ONLY fallback, so Xcode/Expo debug builds can test RevenueCat
# without adding a RevenueCat key here.
#
# Before TestFlight/App Store production, add the REAL Apple public SDK key:
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_REAL_APPLE_PUBLIC_SDK_KEY

# Android production later, if needed:
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_REAL_ANDROID_PUBLIC_SDK_KEY

# Exact values from the current RevenueCat project:
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID="skill+ Pro"
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
